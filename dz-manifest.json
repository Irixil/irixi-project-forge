{
  "protocol_version": "1.0",
  "workflow_version": "2026-08-30",
  "id": "dz",
  "name": "Irixi Project Forge",
  "description": "A platform-neutral workflow that guides a nontechnical user from an idea or current project state to a verified product or an honest implementation handoff.",
  "source": "https://github.com/Irixil/irixi-project-forge",
  "raw_base_url": "https://raw.githubusercontent.com/Irixil/irixi-project-forge/main/",
  "license": {
    "name": "PolyForm Perimeter License 1.0.1",
    "path": "LICENSE.md",
    "url": "https://polyformproject.org/licenses/perimeter/1.0.1"
  },
  "compatibility": {
    "host_allowlist": false,
    "minimum_host_requirement": "accepts text instructions",
    "routing_basis": "observed capabilities, never vendor or model name",
    "generic_entrypoint": "portable/DZ-UNIVERSAL.md"
  },
  "entrypoints": {
    "agent_skill": "SKILL.md",
    "universal_prompt": "portable/DZ-UNIVERSAL.md",
    "adapter_guide": "adapters/README.md",
    "adapter_rules": "references/platform-adapters.md",
    "capability_schema": "adapters/dz-capabilities.schema.json",
    "capability_example": "adapters/example-capabilities.json",
    "openai_metadata": "agents/openai.yaml"
  },
  "reference_sets": {
    "conversation": [
      "references/guided-dialogue.md",
      "references/takeover-resume.md"
    ],
    "workflow": [
      "references/phase-gates.md",
      "references/artifact-chain.md"
    ],
    "delivery": [
      "references/handbook-routing.md",
      "references/reuse-scout.md"
    ],
    "agent_product": [
      "references/agent-harness.md"
    ],
    "host_adapter": [
      "references/platform-adapters.md"
    ],
    "codex_adapter": [
      "references/codex-native.md"
    ],
    "artifact_templates": [
      "references/artifacts/intent.md",
      "references/artifacts/spec.md",
      "references/artifacts/plan.md",
      "references/artifacts/verification.md",
      "references/artifacts/review-release.md",
      "references/artifacts/feedback.md"
    ]
  },
  "invocation_hints": [
    "@dz",
    "$dz",
    "DZ启动"
  ],
  "generic_invocation": "DZ启动：",
  "capability_envelope": {
    "opening_tag": "<DZ_HOST_CAPABILITIES>",
    "closing_tag": "</DZ_HOST_CAPABILITIES>",
    "trusted_roles": [
      "system",
      "developer",
      "host-runtime"
    ]
  },
  "selection_order": [
    "release",
    "build",
    "collaborate",
    "guide"
  ],
  "profiles": {
    "guide": {
      "required_capabilities": {},
      "behavior": "Clarify, challenge, confirm decisions, review supplied material, and produce a copyable handoff. Never claim to have inspected, built, tested, deployed, or remembered anything the host cannot access."
    },
    "collaborate": {
      "required_capabilities": {
        "file_read": "yes"
      },
      "behavior": "Inspect available project evidence and prepare precise decisions or changes. Do not claim execution that the host cannot perform."
    },
    "build": {
      "required_capabilities": {
        "file_read": "yes",
        "file_write": "yes",
        "command_execution": "yes"
      },
      "behavior": "After the three user confirmations, implement small slices and collect reproducible evidence with the host's native tools."
    },
    "release": {
      "required_capabilities": {
        "file_read": "yes",
        "file_write": "yes",
        "command_execution": "yes",
        "external_write": "yes",
        "deployment": "yes",
        "approval_flow": "yes"
      },
      "behavior": "Prepare and verify release work, but deploy only after scope-specific human approval."
    }
  },
  "non_negotiable_behavior": {
    "plain_language": true,
    "complete_beginner_repeat_back_check": true,
    "ordinary_max_blocks": 2,
    "ordinary_max_bullets": 4,
    "ordinary_layout": "two_paragraphs_or_four_bullets_not_both",
    "ordinary_chinese_character_target": 180,
    "ordinary_english_word_target": 120,
    "ordinary_questions_per_turn": 1,
    "takeover_max_lines": 4,
    "takeover_chinese_character_target": 220,
    "beginner_decision_card_target_items": 6,
    "decision_completeness_overrides_length_target": true,
    "separate_prebuild_confirmations": 3,
    "capability_truthfulness": true,
    "anchor_before_reuse_search": true,
    "public_repository_is_not_reuse_permission": true,
    "third_party_parts_require_provenance_tests_and_exit_path": true,
    "third_party_experiment_requires_passed_hard_gates_and_security_isolation": true,
    "third_party_release_requires_exact_artifact_compliance_evidence": true,
    "external_action_requires_current_authority": true,
    "preserve_valid_midtask_work": true
  }
}
