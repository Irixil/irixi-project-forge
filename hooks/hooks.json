{
  "description": "Keep active DZ projects moving and permit truthful waiting, pause, cancellation, or closure.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/dz_codex_stop_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\dz_codex_stop_hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking whether DZ may stop"
          }
        ]
      }
    ]
  }
}
